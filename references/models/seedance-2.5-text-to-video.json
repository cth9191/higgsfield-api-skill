  "verified_at": "2026-09-16",
  "environment": "production",
  "pricing": {
    "method": "per_second_rate_from_description",
    "reference_aspect_ratio": "16:9",
    "verified_at": "2026-09-28",
    "note": "POST /estimate returns only a text pricing_description (no usd). The helper multiplies the quoted per-second rate for the requested resolution by duration; non-16:9 results are approximate."
